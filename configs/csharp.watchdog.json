{
  "$schema": "../schemas/watchdog-config.schema.json",
  "schemaVersion": 1,
  "name": "csharp",
  "label": "C# language server (Roslyn)",
  "description": "Microsoft.CodeAnalysis.LanguageServer started by the C# extension (ms-dotnettools.csharp).",
  "match": { "processNames": ["*"], "ownership": "window", "commandLine": "Microsoft\\.CodeAnalysis\\.LanguageServer" },
  "thresholds": { "warningPrivateGiB": 4, "actionPrivateGiB": 8, "consecutiveSamples": 3 },
  "action": { "mode": "notifyOnly", "restartCommand": "dotnet.restartServer" }
}